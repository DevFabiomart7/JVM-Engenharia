# Copy this file to server/.env for local use, or set these values as host secrets.
PORT=3000
MAIL_TO=joao.nunes@jvmengenharia.com.br
MAIL_FROM="JVM Engenharia <site@SEU-DOMINIO-VERIFICADO.com.br>"
RESEND_API_KEY=re_XXXXXXXXXXXXXXXX

# Exact public site origins, separated by commas. Example for local development:
ALLOWED_ORIGINS=http://localhost:3000

# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For
# and X-Forwarded-Proto. Leave false otherwise.
TRUST_PROXY=false

# Obrigatório em produção para rate limit compartilhado entre instâncias.
# Crie um banco Redis compatível com Upstash e configure os dois valores como segredos.
UPSTASH_REDIS_REST_URL=https://SEU-BANCO.upstash.io
UPSTASH_REDIS_REST_TOKEN=SEU_TOKEN_REST
